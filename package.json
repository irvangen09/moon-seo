{
  "name": "moon-seo",
  "version": "0.1.0",
  "description": "A lightweight, modular WordPress plugin for technical SEO: meta tags, XML sitemaps, and structured data.",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style \"src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "check:version": "node scripts/check-version.js",
    "check:release": "node scripts/check-release.js",
    "verify": "npm run lint && npm run build && npm run check:version && npm run plugin-zip && npm run check:release",
    "format": "wp-scripts format",
    "plugin-zip": "node scripts/plugin-zip.js",
    "makejson": "node scripts/make-json.js",
    "makepot": "wp i18n make-pot . languages/moon-seo.pot --slug=moon-seo --exclude=vendor,node_modules,build,scripts"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "files": [
    "moon-seo.php",
    "uninstall.php",
    "includes",
    "modules",
    "build",
    "src",
    "languages"
  ],
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  },
  "overrides": {
    "typescript": "^5.9.3"
  }
}
